{
	"name": "dsh-bpmn",
	"version": "0.1.0-alpha.1",
	"description": "DeepSeek Harness bundle plugin: BPMN 2.0 visual modeler (bpmn-js) with a full workbench panel and read-only side preview.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Selenium39/dsh-bpmn.git"
	},
	"homepage": "https://github.com/Selenium39/dsh-bpmn#readme",
	"bugs": {
		"url": "https://github.com/Selenium39/dsh-bpmn/issues"
	},
	"keywords": [
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"bpmn",
		"bpmn-js",
		"modeler",
		"process-modeling"
	],
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"main": "lib/index.js",
	"types": "lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./client": {
			"types": "./lib/types/client/index.d.ts",
			"default": "./lib/client.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"lib/types/**/*.d.ts",
		"cordis.patch.yml",
		"README.md",
		"docs/*.md",
		"LICENSE"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-runtime"
			],
			"external": [
				"@deepseek-ai/dsh-client-ui-primitives"
			]
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.json && tsdown",
		"prepare": "tsc -b tsconfig.json && tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"engines": {
		"node": "^22.19 || >=24",
		"dsh": ">=0.1.1-rc.2"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"dependencies": {
		"bpmn-js": "18.31.1",
		"bpmn-js-properties-panel": "5.65.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
		"@deepseek-ai/schemastery": "^3.18.1",
		"@types/node": "^22.20.0",
		"@types/react": "~18.3.1",
		"@types/react-dom": "~18.3.1",
		"jsdom": "^30.0.1",
		"lightningcss": "^1.32.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tsdown": "^0.22.2",
		"typescript": "~5.9.3",
		"vitest": "^4.1.8"
	}
}
